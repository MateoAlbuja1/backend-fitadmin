NODE_ENV=production

# Dominios publicos. Deben apuntar a la IP del servidor.
FRONTEND_DOMAIN=TU-DOMINIO.com
API_DOMAIN=api.TU-DOMINIO.com
FITADMIN_API_URL=https://api.TU-DOMINIO.com

# Seguridad
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_UNICO
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA
ADMIN_EMAIL=admin@wxgym.com

# Dominio del frontend autorizado para consumir el backend
CORS_ORIGIN=https://TU-DOMINIO.com,https://www.TU-DOMINIO.com

# PostgreSQL administrado de produccion
POSTGRES_USER=fitadmin
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_POSTGRES
POSTGRES_DB=fitadmin
DATABASE_URL=postgres://fitadmin:CAMBIA_ESTA_CONTRASENA_POSTGRES@postgres:5432/fitadmin

# MongoDB Atlas de produccion
MONGO_INITDB_ROOT_USERNAME=fitadmin
MONGO_INITDB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASENA_MONGO
MONGO_DATABASE=fitadmin_mongo
MONGO_URL=mongodb://fitadmin:CAMBIA_ESTA_CONTRASENA_MONGO@mongo:27017/fitadmin_mongo?authSource=admin

# Servicios internos
AUTH_SERVICE_URL=http://auth-service:3001
GYM_SERVICE_URL=http://gym-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
REPORT_SERVICE_URL=http://report-service:3004

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=TU_CLIENT_ID
PAYPAL_CLIENT_SECRET=TU_CLIENT_SECRET
PAYPAL_CURRENCY=USD
